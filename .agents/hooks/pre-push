#!/usr/bin/env bash
#
# pre-push - 保护 main / develop
#   - 禁止删除 main / develop
#   - 禁止 force-push 到 main / develop
#   - 禁止非快进推送 main / develop（覆盖: GIT_FLOW_ALLOW_FORCE=1）
#   - feature/* 分支 force 允许但告警
#
# stdin 每行: <本地 ref> <本地 oid> <远端 ref> <远端 oid>

set -u

PROTECTED="refs/heads/main refs/heads/develop"

force=0
case "$*" in
  *--force*|*-f*|*+refs/heads/*) force=1 ;;
esac

allow_force="${GIT_FLOW_ALLOW_FORCE:-0}"
fail=0

while read -r local_ref local_oid remote_ref remote_oid; do
  is_protected=0
  for p in $PROTECTED; do
    [ "$remote_ref" = "$p" ] && is_protected=1
  done

  is_force=0
  case "$local_ref" in
    +*) is_force=1 ;;
  esac

  # 删除分支: 本地 oid 全零
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    if [ "$is_protected" -eq 1 ]; then
      printf '[pre-push] 拦截: 禁止删除受保护分支 %s\n' "$remote_ref" >&2
      fail=1
    fi
    continue
  fi

  # 新建分支: 远端 oid 全零，放行
  [ "$remote_oid" = "0000000000000000000000000000000000000000" ] && continue

  # 判断是否快进: 本地 oid 是否是远端 oid 的后代
  if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    non_ff=1
  else
    non_ff=0
  fi

  if [ "$is_protected" -eq 1 ]; then
    if [ "$is_force" -eq 1 ] || [ "$force" -eq 1 ] || [ "$non_ff" -eq 1 ]; then
      if [ "$allow_force" = "1" ]; then
        printf '[pre-push] 警告: 受保护分支 %s 的强制/非快进推送已被 GIT_FLOW_ALLOW_FORCE 放行\n' "$remote_ref" >&2
      else
        printf '[pre-push] 拦截: 禁止对 %s 做强制/非快进推送（发布请走受保护的合并流程）\n' "$remote_ref" >&2
        printf '  确认安全可覆盖: GIT_FLOW_ALLOW_FORCE=1 git push ...\n' >&2
        fail=1
      fi
    fi
  else
    if [ "$is_force" -eq 1 ] || [ "$force" -eq 1 ]; then
      printf '[pre-push] 警告: 对 %s 使用 force 推送，请确认没有覆盖他人工作\n' "$remote_ref" >&2
    fi
  fi
done

[ "$fail" -eq 0 ] || exit 1
exit 0
