#!/usr/bin/env bash
#
# commit-msg - 校验 Conventional Commits（英文类型 + 中文/英文主题）
# 允许: feat/fix/docs/style/refactor/perf/test/build/ci/chore/revert
# 允许: 合并提交（Merge ...）与还原提交（Revert ...）
#
# 跳过: GIT_FLOW_SKIP_COMMIT_MSG=1 git commit ...

set -u

[ "${GIT_FLOW_SKIP_COMMIT_MSG:-0}" = "1" ] && exit 0

msg=$(cat "$1")

case "$msg" in
  Merge\ *) exit 0 ;;
  Revert\ *) exit 0 ;;
esac

first_line=$(printf '%s\n' "$msg" | head -1)

if ! printf '%s' "$first_line" | grep -q -E '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  printf '[commit-msg] 拦截: 提交信息不符合 Conventional Commits\n' >&2
  printf '  正确示例: feat: 添加用户登录 / fix(parser): 修复空输入崩溃 / docs!: 重写 README\n' >&2
  printf '  跳过: GIT_FLOW_SKIP_COMMIT_MSG=1 git commit ...\n' >&2
  exit 1
fi

# 类型后的主题不能以大写字母开头（保持英文类型 + 中文主题的约定）
if printf '%s' "$first_line" | grep -q -E '^[a-z]+(\([a-z0-9._/-]+\))?!?: [A-Z]'; then
  printf '[commit-msg] 提示: 主题以大写字母开头，建议小写（如 feat: add login）\n' >&2
fi

exit 0
