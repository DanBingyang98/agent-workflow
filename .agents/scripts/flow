#!/usr/bin/env bash
#
# flow - dev 中心分支模型命令集（中文版 agent 工作流）
#
# 分支模型: main（生产镜像）+ develop（远程集成分支），两者 PR-only；
#           feature/* fix/* docs/* chore/* 从 origin/develop 切出；
#           hotfix/* 从 origin/main 切出，PR 合 main 后须回合 develop。
# 合并只在托管平台 PR 服务端发生，本脚本不做本地合并。
#
# 用法:
#   flow feature start <name>          从 origin/develop 创建 feature/<name>
#   flow feature finish <name>         校验并汇报，默认不碰远程
#   flow feature finish --push <name>  显式授权后推送分支（PR 交给项目流程）
#   flow fix|docs|chore <同上>
#   flow hotfix start <name>           从 origin/main 创建 hotfix/<name>
#   flow hotfix finish [--push] <name>
#   flow status                        显示当前分支与仓库状态
#   flow help                          显示本帮助

set -u

SCRIPTS_DIR="$(cd "$(dirname "$0")" && pwd)"
GUARD="$SCRIPTS_DIR/guard"

die() {
  printf '[flow] 错误: %s\n' "$1" >&2
  exit 1
}

usage() {
  sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
}

require_guard() {
  [ -x "$GUARD" ] || die "缺少 guard 脚本: $GUARD（请 chmod +x）"
}

start_branch() {
  local prefix="$1" name="$2" base_remote="$3" base_local="$4" target
  require_guard
  "$GUARD" branch-name "$name" || exit 1
  "$GUARD" clean-check || exit 1
  target="$prefix/$name"
  "$GUARD" branch-missing "$target" || exit 1
  git fetch origin >/dev/null 2>&1 || true
  if git rev-parse --verify --quiet "origin/$base_remote" >/dev/null 2>&1; then
    git checkout -b "$target" "origin/$base_remote" || die "创建 $target 失败（基于 origin/$base_remote）"
    printf '[flow] 已创建 %s（基于 origin/%s）\n' "$target" "$base_remote"
  elif git rev-parse --verify --quiet "$base_local" >/dev/null 2>&1; then
    git checkout -b "$target" "$base_local" || die "创建 $target 失败（基于本地 $base_local）"
    printf '[flow] 已创建 %s（基于本地 %s；未找到 origin/%s）\n' "$target" "$base_local" "$base_remote"
  else
    die "找不到基线分支 origin/$base_remote 或 $base_local"
  fi
}

finish_branch() {
  local prefix="$1" name="$2" target base push=0
  require_guard
  [ "${3:-}" = "--push" ] && push=1
  target="$prefix/$name"
  "$GUARD" branch-exists "$target" || exit 1
  "$GUARD" branch-prefix-ok "$target" || exit 1
  base=$("$GUARD" branch-base "$target") || exit 1
  printf '[flow] 分支 %s 待交付（合并只在 PR 服务端发生，本脚本不本地合并）\n' "$target"
  printf '[flow] 最近提交:\n'
  git log --oneline -5 "$target" 2>/dev/null || true
  printf '[flow] 基线: origin/%s（push 时落后会被 pre-push 硬拦）\n' "$base"
  if [ "$push" -eq 1 ]; then
    git push -u origin "$target" || die "推送失败：若落后 origin/$base，先 rebase 再 --force-with-lease 重推"
    printf '[flow] 已推送 %s。请按项目托管流程创建 PR（模板见 .agents/docs/pr-template.md）\n' "$target"
    if [ "$prefix" = "hotfix" ]; then
      printf '[flow] 提示: hotfix 合入 main 后当天必须回合 develop（发布闸兜底）\n'
    fi
  else
    printf '[flow] 未推送（默认不碰远程）。确认后: flow %s finish --push %s\n' "$prefix" "$name"
  fi
}

status_cmd() {
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "(不在 git 仓库)")
  printf '[flow] 当前分支: %s\n' "$branch"
  printf '[flow] 最近提交:\n'
  git log --oneline -5 2>/dev/null || true
  printf '[flow] 工作区:\n'
  git status --short 2>/dev/null | head -10 || true
  [ -n "$(git status --porcelain 2>/dev/null)" ] && printf '[flow] 警告：有未提交改动\n'
}

case "${1:-}" in
  feature|fix|docs|chore)
    case "${2:-}" in
      start) start_branch "$1" "${3:-}" develop develop ;;
      finish)
        case "${3:-}" in
          --push) finish_branch "$1" "${4:-}" --push ;;
          *) finish_branch "$1" "${3:-}" "" ;;
        esac
        ;;
      *) echo "用法: flow $1 <start|finish [--push]> <name>" >&2; exit 2 ;;
    esac
    ;;
  hotfix)
    case "${2:-}" in
      start) start_branch hotfix "${3:-}" main main ;;
      finish)
        case "${3:-}" in
          --push) finish_branch hotfix "${4:-}" --push ;;
          *) finish_branch hotfix "${3:-}" "" ;;
        esac
        ;;
      *) echo "用法: flow hotfix <start|finish [--push]> <name>" >&2; exit 2 ;;
    esac
    ;;
  status) status_cmd ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
